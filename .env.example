# Local reference only. Store the credential in the OS credential manager.
# Never put an API key value in this tracked example.
# query resolves only the selected provider's reference; doctor never retrieves it.
TOKEN_MAXXXER_CLAUDE_CREDENTIAL_REF=keychain://your-service/your-account
# TOKEN_MAXXXER_OPENAI_CREDENTIAL_REF=keychain://your-openai-service/your-account
# TOKEN_MAXXXER_COPILOT_CREDENTIAL_REF=keychain://your-copilot-service/your-account
# Direct keys may be supplied through process environment variables:
# ANTHROPIC_API_KEY, OPENAI_API_KEY. Do not write their values in this file.
